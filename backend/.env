# ==============================================================
# HỆ THỐNG GIÁM SÁT BÁO CHÁY & CẢNH BÁO ZALO (CANH_BAO_CHAY_ZALO)
# ==============================================================

# Cấu hình máy chủ
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
SECRET_KEY=fire_zalo_secret_key_change_me_in_production_2026

# Cơ sở dữ liệu mặc định (SQLite)
DATABASE_URL=sqlite:///./data/fire_system.db

# Khi cần dùng PostgreSQL, bỏ comment dòng dưới:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fire_zalo_db

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Cấu hình AI & Báo cháy
FIRE_CONFIDENCE_THRESHOLD=0.15
FIRE_ALERT_CONFIDENCE_THRESHOLD=0.40
FIRE_SMOKE_CONFIDENCE_THRESHOLD=0.35
FIRE_CONFIRMATION_FRAMES=2
FIRE_ALERT_COOLDOWN=25

# Cấu hình Zalo OA & ImgBB (có thể cấu hình trên giao diện Web /settings)
ENABLE_FIRE_ZALO=true
ZALO_BURST_COUNT=3
ZALO_BURST_INTERVAL=5
IMGBB_API_KEY=
